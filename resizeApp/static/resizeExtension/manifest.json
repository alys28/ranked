{
    "manifest_version": 3,
    "name": "Image Resizer",
    "version": "1.0",
    "description": "Resize Logos to 250px x 150px",
    "permissions": ["activeTab","scripting", "http://*/", "https://*/" ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {"16": "icon.png","48": "icon.png","128": "icon.png"}
    },
    "content_scripts": [{
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }],
    "host_permissions": [
      "http://127.0.0.1:8000/*"
    ]
  }


  